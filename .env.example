# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.rayanco.com
# Staging stays noindex. Only set to "true" on production after go-live sign-off.
NEXT_PUBLIC_INDEXABLE=false

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Images ---
# Photos live in Supabase Storage (buckets listing-media / listing-incoming, created by migration
# 20261123000001_storage.sql). No extra keys needed. Production needs the Supabase Pro plan (100 GB).
# Secret for the daily incoming/ cleanup cron (Vercel sends it as a Bearer token). 16+ chars.
CRON_SECRET=

# --- Contact ---
# TODO(owner): confirm the WhatsApp number for listings (international format, digits only, e.g. 966509747741).
NEXT_PUBLIC_WHATSAPP_NUMBER=
